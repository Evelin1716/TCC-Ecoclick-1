# Copie este arquivo para ".env" e preencha os valores. NUNCA envie o .env ao Git.

# Ambiente: development | production
NODE_ENV=development
PORT=3000

# PostgreSQL (formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public)
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/ecoclick?schema=public"

# Segredo para assinar as sessões (JWT). Gere um valor longo e aleatório (mínimo 32 caracteres), por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cookie de sessão: em produção (HTTPS) use true
COOKIE_SECURE=false

# Endereço público do site (usado nos links de e-mail) e origens autorizadas a chamar a API de outro endereço
# (ex.: frontend aberto pelo Live Server). Separe por vírgula.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# O backend também serve a pasta frontend/ (true = tudo em http://localhost:3000)
SERVE_FRONTEND=true

# Recuperação de senha por e-mail (opcional). Sem SMTP, o link é apenas escrito no console do servidor em desenvolvimento.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="EcoClick <nao-responda@exemplo.com>"
PASSWORD_RESET_TTL_MIN=60

# Primeiro administrador (usado só pelo "npm run db:seed", opcional). Deixe vazio para não criar.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
