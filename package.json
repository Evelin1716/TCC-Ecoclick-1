{
  "name": "tcc-ecoclick",
  "version": "1.0.0",
  "description": "EcoClick — descarte correto de eletrônicos: pontos de coleta, agendamentos, missões, recompensas e comunidade.",
  "private": true,
  "main": "backend/server.js",
  "engines": { "node": ">=18.18" },
  "scripts": {
    "dev": "nodemon --watch backend --ext js,json backend/server.js",
    "start": "node backend/server.js",
    "frontend": "http-server frontend -p 5500 -c-1 --cors",
    "dev:all": "concurrently -n api,web -c green,blue \"npm run dev\" \"npm run frontend\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "setup": "npm install && prisma generate && prisma migrate dev && prisma db seed",
    "check": "node scripts/check-project.js",
    "postinstall": "prisma generate"
  },
  "prisma": { "seed": "node prisma/seed.js" },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "http-server": "^14.1.1",
    "nodemon": "^3.1.4",
    "prisma": "^5.22.0"
  }
}
